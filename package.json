{
  "name": "cron-expression-validator",
  "version": "2.0.0",
  "description": "cron quartz expression validator",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewaldasoro/cron-expression-validator.git"
  },
  "homepage": "https://github.com/andrewaldasoro/cron-expression-validator#readme",
  "bugs": {
    "url": "https://github.com/andrewaldasoro/cron-expression-validator/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "keywords": [
    "cron",
    "quartz",
    "time",
    "validator"
  ],
  "author": "Kev Aldasoro",
  "license": "ISC",
  "packageManager": "pnpm@11.16.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
