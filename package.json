{
  "name": "cron-quartz-validator",
  "version": "2.1.1",
  "description": "cron quartz expression validator",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewaldasoro/cron-quartz-validator.git"
  },
  "homepage": "https://github.com/andrewaldasoro/cron-quartz-validator#readme",
  "bugs": {
    "url": "https://github.com/andrewaldasoro/cron-quartz-validator/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint ."
  },
  "keywords": [
    "cron",
    "quartz",
    "time",
    "validator"
  ],
  "author": "Andrew Aldasoro",
  "license": "ISC",
  "packageManager": "pnpm@11.16.0",
  "devDependencies": {
    "oxlint": "^1.76.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
